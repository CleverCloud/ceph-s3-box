Upstream: No, backport of Reef's DELETE /api/cluster/user/<entity> onto Pacific.
From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Clever Cloud <noreply@clever-cloud.com>
Date: Thu, 24 Apr 2026 00:00:00 +0000
Subject: [PATCH] mgr/dashboard: add DELETE /cluster/user/<entity>

Extends the PR #47794 backport (0001-add-cluster-api.patch) with delete
support. Reef ships this natively via CephUserEndpoints.user_delete
(`auth del`); Pacific's upstream dashboard has no route for it at all.

CRUDEndpoint gains a `delete` slot, and create_crud_class emits a
`delete` method on the dynamic RESTController when set. RESTController's
`_method_mapping` already maps the `delete` attribute to
DELETE /<resource_id>, so no routing changes are needed.

Also introduces the `_run_auth_command` helper (mirroring Reef) so the
try/except SendCommandError -> DashboardException mapping is shared
across user_list, user_create, and user_delete. Without this,
`auth ls` racing right after `auth del` lets a transient
SendCommandError leak unwrapped, and CherryPy serves a generic
500 instead of a structured DashboardException.
---
 src/pybind/mgr/dashboard/controllers/_crud.py      |  7 +++++++
 src/pybind/mgr/dashboard/controllers/ceph_users.py | 33 ++++++++++++++++++----
 2 files changed, 32 insertions(+), 8 deletions(-)

--- a/src/pybind/mgr/dashboard/controllers/_crud.py
+++ b/src/pybind/mgr/dashboard/controllers/_crud.py
@@ -296,6 +296,7 @@
     meta: CRUDMeta = CRUDMeta()
     get_all: Optional[CRUDCollectionMethod] = None
     create: Optional[CRUDCollectionMethod] = None
+    delete: Optional[CRUDCollectionMethod] = None

     # for testing purposes
     CRUDClass: Optional[RESTController] = None
@@ -331,6 +332,12 @@
                 def create(self, *args, **kwargs):
                     return outer_self.create.func(self, *args, **kwargs)  # type: ignore

+            if self.delete:
+                @self.delete.doc
+                @wraps(self.delete.func)
+                def delete(self, *args, **kwargs):
+                    return outer_self.delete.func(self, *args, **kwargs)  # type: ignore
+
         cls.CRUDClass = CRUDClass

     def create_meta_class(self, cls):
--- a/src/pybind/mgr/dashboard/controllers/ceph_users.py
+++ b/src/pybind/mgr/dashboard/controllers/ceph_users.py
@@ -24,12 +24,21 @@ class Cap(NamedTuple):


 class CephUserEndpoints:
+    @staticmethod
+    def _run_auth_command(command: str, **kwargs):
+        try:
+            return CephService.send_command('mon', command, **kwargs)
+        except SendCommandError as ex:
+            msg = f'{ex} in command {ex.prefix}'
+            code = 400 if ex.errno == -EINVAL else 500
+            raise DashboardException(msg, code=code)
+
     @staticmethod
     def user_list(_):
         """
         Get list of ceph users and its respective data
         """
-        return CephService.send_command('mon', 'auth ls')["auth_dump"]
+        return CephUserEndpoints._run_auth_command('auth ls')["auth_dump"]

     @staticmethod
     def user_create(_, user_entity: str, capabilities: List[Cap]):
@@ -47,13 +56,17 @@ class CephUserEndpoints:

         logger.debug("Sending command 'auth get-or-create' of entity '%s' with caps '%s'",
                      user_entity, str(caps))
-        try:
-            return CephService.send_command('mon', 'auth get-or-create', entity=user_entity, caps=caps)
-        except SendCommandError as ex:
-            msg = f'{ex} in command {ex.prefix}'
-            if ex.errno == -EINVAL:
-                raise DashboardException(msg, code=400)
-            raise DashboardException(msg, code=500)
+        return CephUserEndpoints._run_auth_command('auth get-or-create',
+                                                   entity=user_entity, caps=caps)
+
+    @staticmethod
+    def user_delete(_, user_entity: str):
+        """
+        Delete a ceph user and its defined capabilities.
+        """
+        logger.debug("Sending command 'auth del' of entity '%s'", user_entity)
+        CephUserEndpoints._run_auth_command('auth del', entity=user_entity)
+        return f"Successfully deleted user '{user_entity}'"


 create_cap_container = ArrayHorizontalContainer('Capabilities', 'capabilities',
@@ -91,6 +104,10 @@ create_form = Form(path='/cluster/user/create',
     create=CRUDCollectionMethod(
         func=CephUserEndpoints.user_create,
         doc=EndpointDoc("Create Ceph User")
+    ),
+    delete=CRUDCollectionMethod(
+        func=CephUserEndpoints.user_delete,
+        doc=EndpointDoc("Delete Ceph User")
     )
 )
 class CephUser(NamedTuple):
--
